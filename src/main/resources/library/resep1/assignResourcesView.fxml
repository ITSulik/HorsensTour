<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml"
            fx:controller="library.resep1.View.AssignResourcesController"
            fitToWidth="true" styleClass="dialog-scroll" prefWidth="460" maxHeight="640">
    <VBox styleClass="dialog-card" spacing="16">
        <padding>
            <Insets top="24" right="24" bottom="24" left="24"/>
        </padding>

        <Label fx:id="titleLabel" text="Assign resources" styleClass="dialog-title" wrapText="true"/>
        <Label fx:id="timeRangeLabel" wrapText="true" styleClass="helper-text"/>

        <VBox fx:id="emptyStateBox" spacing="4" visible="false" managed="false" styleClass="empty-state">
            <Label fx:id="emptyTimeSlotLabel" styleClass="empty-state-time"/>
            <Label text="No buses or chauffeurs are available for this time slot." wrapText="true"
                   styleClass="empty-state-text"/>
        </VBox>

        <VBox fx:id="resultsBox" spacing="16">
            <VBox spacing="8">
                <Label text="Available buses" styleClass="section-label"/>
                <VBox fx:id="busesListBox" spacing="6"/>
            </VBox>
            <VBox spacing="8">
                <Label text="Available chauffeurs" styleClass="section-label"/>
                <VBox fx:id="chauffeursListBox" spacing="6"/>
            </VBox>
        </VBox>

        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button text="Cancel" styleClass="btn-secondary" onAction="#onCancel"/>
        </HBox>
    </VBox>
</ScrollPane>
