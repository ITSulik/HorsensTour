<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="10.0"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="library.resep1.View.HelloController">

    <padding>
        <Insets bottom="20" left="20" right="20" top="20"/>
    </padding>

    <Label text="Bus"/>

    <TextField fx:id="busNumberField" promptText="Bus number"/>
    <ComboBox fx:id="busTypeBox" promptText="Bus type"/>
    <TextField fx:id="capacityField" promptText="Capacity"/>
    <TextField fx:id="purposeField" promptText="Purpose"/>

    <Button text="Add Bus" onAction="#addBus"/>

    <ListView fx:id="busListView"/>

    <Button text="Edit Bus" onAction="#editBus"/>
    <Button text="Delete Bus" onAction="#deleteBus"/>

    <Label text="Chauffeur"/>

    <TextField fx:id="chauffeurNameField" promptText="Name"/>
    <TextField fx:id="experienceField" promptText="Experience"/>
    <TextField fx:id="preferencesField" promptText="Preferences"/>

    <Button text="Add Chauffeur" onAction="#addChauffeur"/>

    <ListView fx:id="chauffeurListView"/>
    <Button text="Edit Chauffeur" onAction="#editChauffeur"/>
    <Button text="Delete Chauffeur" onAction="#deleteChauffeur"/>

</VBox>