<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml"
      fx:controller="library.resep1.View.ConfirmDeleteController"
      styleClass="dialog-card" spacing="16" prefWidth="360">
    <padding>
        <Insets top="22" right="22" bottom="22" left="22"/>
    </padding>

    <Label fx:id="titleLabel" text="Delete" styleClass="dialog-title"/>
    <Label fx:id="messageLabel" text="" wrapText="true" styleClass="dialog-message"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel" styleClass="btn-secondary" onAction="#onCancel"/>
        <Button fx:id="confirmButton" text="Delete" styleClass="btn-danger" onAction="#onConfirm"/>
    </HBox>
</VBox>
