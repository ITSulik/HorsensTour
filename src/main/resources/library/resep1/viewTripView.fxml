<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="library.resep1.View.ViewTripController"
      styleClass="dialog-card"
      spacing="14"
      prefWidth="460">

    <padding>
        <Insets top="24"
                right="24"
                bottom="24"
                left="24"/>
    </padding>

    <Label text="Trip details"
           styleClass="dialog-title"/>

    <VBox spacing="6">
        <Label text="Trip ID"
               styleClass="field-label"/>

        <Label fx:id="tripIdLabel"
               styleClass="assigned-value"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Destination"
               styleClass="field-label"/>

        <Label fx:id="destinationLabel"
               styleClass="assigned-value"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Start"
               styleClass="field-label"/>

        <Label fx:id="startLabel"
               styleClass="assigned-value"/>
    </VBox>

    <VBox spacing="6">
        <Label text="End"
               styleClass="field-label"/>

        <Label fx:id="endLabel"
               styleClass="assigned-value"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Additional details"
               styleClass="field-label"/>

        <Label fx:id="detailsLabel"
               wrapText="true"
               styleClass="assigned-value"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Assigned bus"
               styleClass="field-label"/>

        <Label fx:id="busLabel"
               styleClass="assigned-value"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Assigned chauffeur"
               styleClass="field-label"/>

        <Label fx:id="chauffeurLabel"
               styleClass="assigned-value"/>
    </VBox>

    <HBox alignment="CENTER_RIGHT">
        <Button text="Close"
                styleClass="btn-secondary"
                onAction="#onClose"/>
    </HBox>

</VBox>
