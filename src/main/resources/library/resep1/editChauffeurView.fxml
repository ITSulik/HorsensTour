<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER_LEFT"
      spacing="12.0"
      prefWidth="350.0"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="library.resep1.View.EditChauffeurController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Edit chauffeur"
           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <VBox fx:id="bannerBox" styleClass="banner, banner-error" visible="false" managed="false">
        <Label fx:id="bannerLabel" text="Please fix the highlighted fields." wrapText="true" styleClass="banner-title"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Name"/>
        <TextField fx:id="nameField"
               promptText="Chauffeur name"/>
        <Label fx:id="nameError" styleClass="error-text" wrapText="true" visible="false" managed="false"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Years of experience"/>
        <TextField fx:id="experienceField"
               promptText="Years of experience"/>
        <Label fx:id="experienceError" styleClass="error-text" wrapText="true" visible="false" managed="false"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Preferences"/>
        <TextField fx:id="preferencesField"
               promptText="Preferences"/>

    </VBox>


    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Button text="Cancel"
                onAction="#cancel"/>

        <Button text="Save chauffeur"
                onAction="#saveChauffeur"/>


    </HBox>

</VBox>