<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER_LEFT"
      spacing="12.0"
      prefWidth="350.0"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="library.resep1.View.EditBusController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <VBox fx:id="bannerBox" styleClass="banner, banner-error" visible="false" managed="false">
        <Label fx:id="bannerLabel" text="Please fix the highlighted fields." wrapText="true" styleClass="banner-title"/>
    </VBox>

    <VBox spacing="6">
    <Label text="Edit bus"
           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    </VBox>

    <VBox spacing="6">
    <Label text="Bus number"/>
    <TextField fx:id="busNumberField"
               promptText="Bus number"/>
        <Label fx:id="numberError" styleClass="error-text" wrapText="true" visible="false" managed="false"/>
    </VBox>

    <VBox spacing="6">
    <Label text="Bus type"/>
    <ComboBox fx:id="busTypeBox"
              promptText="Bus type"/>
    </VBox>

    <VBox spacing="6">
    <Label text="Capacity"/>
    <TextField fx:id="capacityField"
               promptText="Capacity"/>
        <Label fx:id="capacityError" styleClass="error-text" wrapText="true" visible="false" managed="false"/>
    </VBox>

    <VBox spacing="6">
    <Label text="Purpose"/>
    <TextField fx:id="purposeField"
               promptText="Purpose"/>
    </VBox>

    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Button text="Cancel"
                onAction="#cancel"/>

        <Button text="Save bus"
                onAction="#saveBus"/>
    </HBox>

</VBox>